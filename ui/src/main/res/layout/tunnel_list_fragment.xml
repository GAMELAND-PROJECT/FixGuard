<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <import type="org.amnezia.awg.model.ObservableTunnel" />

        <variable
            name="fragment"
            type="org.amnezia.awg.fragment.TunnelListFragment" />

        <variable
            name="rowConfigurationHandler"
            type="org.amnezia.awg.databinding.ObservableKeyedRecyclerViewAdapter.RowConfigurationHandler" />

        <variable
            name="tunnels"
            type="org.amnezia.awg.databinding.ObservableKeyedArrayList&lt;String, ObservableTunnel&gt;" />
    </data>

    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:id="@+id/main_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#0D1117"
        android:clipChildren="false">

        <!-- Main Responsive Scrollable Dashboard (fills 100% viewport, zero scrolling needed on standard/tall phones) -->
        <androidx.core.widget.NestedScrollView
            android:id="@+id/dashboard_scroll_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:scrollbars="none"
            android:overScrollMode="never">

            <LinearLayout
                android:id="@+id/smart_connect_panel"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical">

                <!-- 1. Top Section: VIP Profile Card (wrap_content) -->
                <LinearLayout
                    android:id="@+id/top_header_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="16dp"
                    android:paddingTop="12dp"
                    android:paddingBottom="4dp">

                    <!-- VIP Profile Card -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/vip_profile_card"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground"
                        app:cardBackgroundColor="@android:color/transparent"
                        app:cardCornerRadius="20dp"
                        app:cardElevation="0dp"
                        app:strokeColor="#30363D"
                        app:strokeWidth="1.2dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_vip_card"
                            android:orientation="vertical"
                            android:padding="16dp">

                            <!-- Top Row: Avatar + Title + VIP Badge -->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <FrameLayout
                                    android:layout_width="44dp"
                                    android:layout_height="44dp"
                                    android:background="@drawable/bg_smart_button_halo">

                                    <ImageView
                                        android:layout_width="26dp"
                                        android:layout_height="26dp"
                                        android:layout_gravity="center"
                                        android:src="@drawable/ic_vip_crown"
                                        android:contentDescription="VIP Crown" />
                                </FrameLayout>

                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:layout_marginStart="12dp"
                                    android:orientation="vertical">

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="اشتراک ویژه نامحدود"
                                        android:textColor="#FFFFFF"
                                        android:textSize="15sp"
                                        android:textStyle="bold" />

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="2dp"
                                        android:text="شناسه کاربر: #77-VIP • ترافیک نامحدود"
                                        android:textColor="#8B949E"
                                        android:textSize="12sp" />
                                </LinearLayout>

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:background="@drawable/bg_vip_badge"
                                    android:paddingHorizontal="10dp"
                                    android:paddingVertical="4dp"
                                    android:text="VIP فعال"
                                    android:textColor="#FFFFFF"
                                    android:textSize="11sp"
                                    android:textStyle="bold" />
                            </LinearLayout>

                            <!-- Divider -->
                            <View
                                android:layout_width="match_parent"
                                android:layout_height="1dp"
                                android:layout_marginVertical="10dp"
                                android:background="#21262D" />

                            <!-- Bottom Metrics Row -->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <LinearLayout
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:gravity="center_vertical">

                                    <ImageView
                                        android:layout_width="14dp"
                                        android:layout_height="14dp"
                                        android:src="@drawable/ic_shield_check"
                                        android:contentDescription="Shield" />

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginStart="6dp"
                                        android:text="پروتکل اختصاصی هوشمند v2"
                                        android:textColor="#58A6FF"
                                        android:textSize="11sp"
                                        android:textStyle="bold" />
                                </LinearLayout>

                                <View
                                    android:layout_width="0dp"
                                    android:layout_height="1dp"
                                    android:layout_weight="1" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="⚡ مسیر بهینه خودکار"
                                    android:textColor="#3FB950"
                                    android:textSize="11sp"
                                    android:textStyle="bold" />
                            </LinearLayout>
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                </LinearLayout>

                <!-- 2. Middle Section: Dynamic Floating Hub (takes remaining space, auto-centers button) -->
                <LinearLayout
                    android:id="@+id/smart_button_area"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:paddingVertical="10dp">

                    <!-- Center button with multi-layer cyber glowing halos and bezel -->
                    <FrameLayout
                        android:layout_width="280dp"
                        android:layout_height="280dp"
                        android:layout_gravity="center"
                        android:clipChildren="false"
                        android:clipToPadding="false">

                        <!-- Expanding radar pulse wave (layer 1) -->
                        <View
                            android:id="@+id/smart_connect_halo_pulse"
                            android:layout_width="276dp"
                            android:layout_height="276dp"
                            android:layout_gravity="center"
                            android:alpha="0.0"
                            android:background="@drawable/bg_smart_button_halo_secondary" />

                        <!-- Breathing ambient glow aura (layer 2) -->
                        <View
                            android:id="@+id/smart_connect_halo"
                            android:layout_width="250dp"
                            android:layout_height="250dp"
                            android:layout_gravity="center"
                            android:alpha="0.18"
                            android:background="@drawable/bg_smart_button_halo" />

                        <!-- Metallic / Cyber outer frame bezel (layer 3) -->
                        <View
                            android:id="@+id/smart_connect_bezel"
                            android:layout_width="232dp"
                            android:layout_height="232dp"
                            android:layout_gravity="center"
                            android:background="@drawable/bg_cyber_button_bezel" />

                        <!-- Spinning activity ring (layer 4 - active during connection) -->
                        <com.google.android.material.progressindicator.CircularProgressIndicator
                            android:id="@+id/smart_connect_progress"
                            android:layout_width="232dp"
                            android:layout_height="232dp"
                            android:layout_gravity="center"
                            android:indeterminate="true"
                            android:visibility="gone"
                            app:indicatorColor="#58A6FF"
                            app:indicatorSize="232dp"
                            app:trackColor="@android:color/transparent"
                            app:trackThickness="3dp" />

                        <!-- Centerpiece Power Switch (layer 5) -->
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/smart_connect_button"
                            style="@style/Widget.Material3.Button.Icon"
                            android:layout_width="206dp"
                            android:layout_height="206dp"
                            android:layout_gravity="center"
                            android:backgroundTint="#1F6FEB"
                            android:contentDescription="@string/smart_connect"
                            android:insetLeft="0dp"
                            android:insetTop="0dp"
                            android:insetRight="0dp"
                            android:insetBottom="0dp"
                            android:stateListAnimator="@null"
                            android:text=""
                            app:cornerRadius="103dp"
                            app:icon="@drawable/ic_vpn_power"
                            app:iconGravity="textStart"
                            app:iconPadding="0dp"
                            app:iconSize="68dp"
                            app:iconTint="#FFFFFF"
                            app:rippleColor="#58A6FF" />

                        <!-- Concentric Cyber Ring Pattern (layer 6) -->
                        <View
                            android:id="@+id/smart_connect_inner_ring"
                            android:layout_width="152dp"
                            android:layout_height="152dp"
                            android:layout_gravity="center"
                            android:background="@drawable/bg_cyber_inner_ring"
                            android:clickable="false"
                            android:focusable="false" />
                    </FrameLayout>
                </LinearLayout>

                <!-- 3. Bottom Section: Status Pill + Master Telemetry Console (anchored to bottom) -->
                <LinearLayout
                    android:id="@+id/bottom_controls_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:paddingHorizontal="16dp"
                    android:paddingBottom="76dp">

                    <!-- Status pill: placed professionally directly above the card -->
                    <LinearLayout
                        android:id="@+id/status_pill"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:background="@drawable/bg_status_pill"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="18dp"
                        android:paddingVertical="7dp">

                        <View
                            android:id="@+id/status_dot"
                            android:layout_width="10dp"
                            android:layout_height="10dp"
                            android:background="@drawable/bg_status_dot_disconnected" />

                        <TextView
                            android:id="@+id/status_pill_text"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:letterSpacing="0.04"
                            android:text="@string/smart_status_disconnected"
                            android:textColor="#E6EDF3"
                            android:textSize="13sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Unified Master Cyber Telemetry & Security Metrics Console -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/connection_telemetry_card"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:cardBackgroundColor="#111622"
                        app:cardCornerRadius="18dp"
                        app:cardElevation="2dp"
                        app:strokeColor="#243048"
                        app:strokeWidth="1dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:paddingHorizontal="16dp"
                            android:paddingVertical="14dp">

                            <!-- Top Row: Telemetry Status and Live Security Chip -->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:orientation="vertical">

                                    <TextView
                                        android:id="@+id/telemetry_title"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="وضعیت ارتباط امن"
                                        android:textColor="#8B949E"
                                        android:textSize="11sp"
                                        android:textStyle="bold" />

                                    <TextView
                                        android:id="@+id/telemetry_caption"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="2dp"
                                        android:text="@string/smart_connect_ready"
                                        android:textColor="#FFFFFF"
                                        android:textSize="13sp"
                                        android:textStyle="bold" />
                                </LinearLayout>

                                <!-- Live indicators badge: visible when connected -->
                                <LinearLayout
                                    android:id="@+id/telemetry_live_row"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:gravity="center_vertical"
                                    android:visibility="gone"
                                    tools:visibility="visible">

                                    <TextView
                                        android:id="@+id/telemetry_shield_chip"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:background="@drawable/bg_vip_badge"
                                        android:backgroundTint="#152438"
                                        android:paddingHorizontal="9dp"
                                        android:paddingVertical="4dp"
                                        android:text="🛡️ کوانتومی فعال"
                                        android:textColor="#58A6FF"
                                        android:textSize="11sp"
                                        android:textStyle="bold" />
                                </LinearLayout>
                            </LinearLayout>

                            <!-- Subtle Horizontal Divider -->
                            <View
                                android:layout_width="match_parent"
                                android:layout_height="1dp"
                                android:layout_marginVertical="9dp"
                                android:background="#21262D" />

                            <!-- Metrics Matrix: Row 1 (Timer & DNS Protection) -->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal">

                                <!-- Item 1: Timer -->
                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:orientation="vertical">

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="⏱️ زمان اتصال"
                                        android:textColor="#8B949E"
                                        android:textSize="11sp"
                                        android:textStyle="bold" />

                                    <TextView
                                        android:id="@+id/metric_timer_text"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="2dp"
                                        android:text="--:--:--"
                                        android:textColor="#58A6FF"
                                        android:textSize="14sp"
                                        android:textStyle="bold" />
                                </LinearLayout>

                                <!-- Vertical separator -->
                                <View
                                    android:layout_width="1dp"
                                    android:layout_height="match_parent"
                                    android:layout_marginHorizontal="8dp"
                                    android:background="#21262D" />

                                <!-- Item 2: DNS Protection -->
                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:orientation="vertical">

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="🔒 نشت DNS"
                                        android:textColor="#8B949E"
                                        android:textSize="11sp"
                                        android:textStyle="bold" />

                                    <TextView
                                        android:id="@+id/metric_dns_text"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="2dp"
                                        android:text="آماده‌باش"
                                        android:textColor="#8B949E"
                                        android:textSize="13sp"
                                        android:textStyle="bold" />
                                </LinearLayout>
                            </LinearLayout>

                            <!-- Subtle Horizontal Divider -->
                            <View
                                android:layout_width="match_parent"
                                android:layout_height="1dp"
                                android:layout_marginVertical="7dp"
                                android:background="#21262D" />

                            <!-- Metrics Matrix: Row 2 (Smart Route & Anti-Censorship) -->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal">

                                <!-- Item 3: Route -->
                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:orientation="vertical">

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="🌐 مسیر شبکه"
                                        android:textColor="#8B949E"
                                        android:textSize="11sp"
                                        android:textStyle="bold" />

                                    <TextView
                                        android:id="@+id/metric_route_text"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="2dp"
                                        android:text="مسیر خودکار"
                                        android:textColor="#E6EDF3"
                                        android:textSize="13sp"
                                        android:textStyle="bold" />
                                </LinearLayout>

                                <!-- Vertical separator -->
                                <View
                                    android:layout_width="1dp"
                                    android:layout_height="match_parent"
                                    android:layout_marginHorizontal="8dp"
                                    android:background="#21262D" />

                                <!-- Item 4: Anti-Censorship Shield -->
                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:orientation="vertical">

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="🛡️ ضد انسداد"
                                        android:textColor="#8B949E"
                                        android:textSize="11sp"
                                        android:textStyle="bold" />

                                    <TextView
                                        android:id="@+id/metric_shield_text"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="2dp"
                                        android:text="آماده‌باش"
                                        android:textColor="#8B949E"
                                        android:textSize="13sp"
                                        android:textStyle="bold" />
                                </LinearLayout>
                            </LinearLayout>
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                </LinearLayout>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/tunnel_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingBottom="24dp"
            android:paddingTop="380dp"
            android:visibility="@{tunnels.size() > 0 ? android.view.View.VISIBLE : android.view.View.GONE}"
            app:configurationHandler="@{rowConfigurationHandler}"
            app:items="@{tunnels}"
            app:layout="@{@layout/tunnel_list_item}"
            tools:itemCount="12"
            tools:listitem="@layout/tunnel_list_item" />

        <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
            android:id="@+id/optimize_warp_fab"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|start"
            android:layout_margin="@dimen/fab_margin"
            android:contentDescription="@string/warp_endpoint_optimize"
            android:text="@string/warp_endpoint_optimize"
            android:visibility="gone"
            app:icon="@drawable/ic_action_generate" />

    </androidx.coordinatorlayout.widget.CoordinatorLayout>
</layout>
