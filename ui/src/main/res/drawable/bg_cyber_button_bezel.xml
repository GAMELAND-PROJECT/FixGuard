<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Outer dashed tech notches (cyber radar track) -->
    <item>
        <shape android:shape="oval">
            <stroke
                android:width="2dp"
                android:color="#484F58"
                android:dashWidth="8dp"
                android:dashGap="4dp" />
        </shape>
    </item>

    <!-- Metallic dark bezel housing inset by 3dp -->
    <item
        android:bottom="3dp"
        android:left="3dp"
        android:right="3dp"
        android:top="3dp">
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="116dp"
                android:startColor="#1C2128"
                android:endColor="#0D1117" />
            <stroke
                android:width="1.5dp"
                android:color="#30363D" />
        </shape>
    </item>

    <!-- Inner specular rim inset by 7dp -->
    <item
        android:bottom="7dp"
        android:left="7dp"
        android:right="7dp"
        android:top="7dp">
        <shape android:shape="oval">
            <stroke
                android:width="1dp"
                android:color="#21262D" />
        </shape>
    </item>
</layer-list>
