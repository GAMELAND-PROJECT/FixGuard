<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Concentric cyber dashed ring around power icon -->
    <item>
        <shape android:shape="oval">
            <stroke
                android:width="1.5dp"
                android:color="#40FFFFFF"
                android:dashWidth="6dp"
                android:dashGap="4dp" />
        </shape>
    </item>
    <!-- Secondary subtle concentric groove inset by 5dp -->
    <item
        android:bottom="5dp"
        android:left="5dp"
        android:right="5dp"
        android:top="5dp">
        <shape android:shape="oval">
            <stroke
                android:width="1dp"
                android:color="#20FFFFFF" />
        </shape>
    </item>
</layer-list>
